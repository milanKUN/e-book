# Netlify Environment Variables — Guru Netra Frontend
# =====================================================
# Netlify Dashboard → Sites → তোমার site → Site Configuration → Environment Variables
# এখানে এই variables গুলো Add করতে হবে:
#
# KEY                    | VALUE
# -----------------------|---------------------------------------------------
# VITE_API_BASE_URL      | https://gurunetra.gyanpithschool.com/api
# VITE_RAZORPAY_KEY_ID   | rzp_live_XXXXXXXXXXXXXXXXXXXX   (তোমার live key)
# VITE_META_PIXEL_ID     | 1618697346295112
#
# ⚠️ IMPORTANT: VITE_ prefix ছাড়া React frontend এ পাওয়া যাবে না।
# ⚠️ Secret keys (RAZORPAY_KEY_SECRET) কখনো frontend env-এ দেবে না।

VITE_API_BASE_URL=https://gurunetra.gyanpithschool.com/api
VITE_RAZORPAY_KEY_ID=rzp_live_REPLACE_WITH_YOUR_LIVE_KEY_ID
VITE_META_PIXEL_ID=1618697346295112
