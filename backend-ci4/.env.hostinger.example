# ---------------------------------------------------------------
# Guru Netra — Hostinger Production .env Template
# ---------------------------------------------------------------
# এই file টি Hostinger File Manager-এ .env নামে upload করুন
# backend root folder-এ (যেখানে spark file আছে)
# ---------------------------------------------------------------

# App — subdomain URL দিন (trailing slash সহ)
app.baseURL = 'https://gurunetra.gyanpithschool.com/'
app.indexPage = ''
app.forceGlobalSecureRequests = true

# Database — Hostinger cPanel → MySQL Databases থেকে পান
# Database Name format: u465926280_YOURDBNAME
database.default.hostname = 'localhost'
database.default.database = 'u465926280_gurunetra'
database.default.username = 'u465926280_gurunetra'
database.default.password = 'YOUR_DATABASE_PASSWORD_HERE'
database.default.DBDriver = 'MySQLi'
database.default.DBPrefix = ''
database.default.port = 3306

# Razorpay — LIVE (Production) Keys
# Razorpay Dashboard → Settings → API Keys → Generate Live Keys
RAZORPAY_KEY_ID = 'rzp_live_XXXXXXXXXXXXXXXXXXXX'
RAZORPAY_KEY_SECRET = 'XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX'
# Razorpay Dashboard → Webhooks → Add New Webhook → Secret
RAZORPAY_WEBHOOK_SECRET = 'YOUR_WEBHOOK_SECRET'

# Product Price (paise; 100 = Rs 1, 19900 = Rs 199)
PRODUCT_PRICE_PAISE = 100

# Ebook Download — use a long random string (32+ chars)
# Generate here: https://www.random.org/strings/
EBOOK_DOWNLOAD_SECRET = 'GENERATE_A_STRONG_RANDOM_SECRET_HERE_32PLUS_CHARS'
EBOOK_GOOGLE_DRIVE_URL = 'https://drive.google.com/file/d/YOUR_FILE_ID/view?usp=sharing'

# Admin Login Password (change after first login via /admin/login)
ADMIN_SEED_PASSWORD = 'ChangeMe@9999'

# MUST stay as 'production' on Hostinger
CI_ENVIRONMENT = 'production'
